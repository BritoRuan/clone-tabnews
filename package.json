{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "implementation of https://www.tabnews.com.br/ for the course.dev",
  "main": "index.ts",
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "dev:no-migrate": "npm run services:up && npm run services:wait:database && next dev",
    "pretest": "npm run migrations:build:migrations",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate -j ts -m infra/migrations create",
    "migrations:build:migrations": "tsc -p tsconfig.build.json",
    "migrations:up": "npm run migrations:build:migrations && node-pg-migrate -m dist/infra/migrations --envPath .env.development up",
    "migrations:down": "npm run migrations:build:migrations && node-pg-migrate -m dist/infra/migrations --envPath .env.development down",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "next lint --dir .",
    "build": "npm run migrations:build:migrations && next build",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/async-retry": "1.4.9",
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.2",
    "dotenv": "16.4.5",
    "dotenv-expand": "11.0.6",
    "next": "14.2.5",
    "next-connect": "1.0.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "2.2.5",
    "ts-node": "10.9.2",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.0",
    "@commitlint/config-conventional": "19.2.2",
    "@faker-js/faker": "9.7.0",
    "@types/jest": "30.0.0",
    "@types/node-pg-migrate": "2.3.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "commitizen": "4.3.1",
    "concurrently": "8.2.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "28.8.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "node-mocks-http": "1.17.2",
    "prettier": "3.7.4",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
